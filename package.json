{
  "name": "@diginodes/stellarforge-cli",
  "version": "0.1.0",
  "private": false,
  "description": "Command-line interface for building production-ready Stellar applications.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "bin": {
    "stellarforge": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0 <25",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "audit:workflow-permissions": "node scripts/audit-workflow-permissions.mjs"
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"eslint.config.js\" \"vitest.config.ts\" \"package.json\" \"tsconfig*.json\" \".prettierrc\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"eslint.config.js\" \"vitest.config.ts\" \"package.json\" \"tsconfig*.json\" \".prettierrc\"",
    "test": "vitest run",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "test:e2e": "npm run build && node scripts/e2e-smoke.mjs",
    "benchmark:doctor": "npm run build && node scripts/doctor-benchmark.mjs",
    "release:dry-run": "npm pack --dry-run --json",
    "release:publish": "changeset publish"
  },
  "dependencies": {
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigiNodes/stellarforge-cli.git"
  },
  "homepage": "https://github.com/DigiNodes/stellarforge-cli#readme",
  "bugs": {
    "url": "https://github.com/DigiNodes/stellarforge-cli/issues"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
